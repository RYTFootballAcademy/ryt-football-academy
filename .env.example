# Local development defaults
DATABASE_URL=sqlite:///academy.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Optional. If set, write operations under /faos require this value in X-API-Key.
FAOS_API_KEY=

# Future integrations (not required for the local MVP)
OPENAI_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
